{
  "id": "todolist",
  "name": "Hana Todo",
  "version": "0.2.1",
  "description": "Persistent Todo, project, time intent, Reminder, recurrence, Agent automation, review, and strict exchange workflow.",
  "trust": "full-access",
  "hidden": true,
  "activationEvents": [
    "onStartup",
    "onPageOpen",
    "onToolCall"
  ],
  "contributes": {
    "page": {
      "title": {
        "zh-CN": "Todo",
        "zh-TW": "Todo",
        "ja": "Todo",
        "ko": "Todo",
        "en": "Todo"
      },
      "route": "/page",
      "icon": "check-circle"
    }
  },
  "capabilities": [
    "agent.read",
    "session.write",
    "task.control",
    "task.write"
  ],
  "ui": {
    "hostCapabilities": [
      "resource.pick"
    ]
  }
}
