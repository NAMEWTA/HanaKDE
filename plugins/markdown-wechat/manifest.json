{
  "id": "markdown-wechat",
  "name": "Markdown WeChat",
  "version": "0.1.0",
  "description": "Markdown editing, WeChat article preview, safe rich-copy, resource import, and HTML delivery.",
  "minAppVersion": "0.0.4",
  "trust": "full-access",
  "hidden": true,
  "activationEvents": [
    "onPageOpen",
    "onWidgetOpen",
    "onToolCall"
  ],
  "capabilities": [
    "resource.read",
    "resource.write"
  ],
  "ui": {
    "hostCapabilities": [
      "resource.pick",
      "clipboard.writeText"
    ]
  },
  "contributes": {
    "page": {
      "title": "Markdown WeChat",
      "route": "/page",
      "icon": "file-text"
    },
    "widget": {
      "title": "Markdown WeChat",
      "route": "/widget",
      "icon": "panel-right"
    }
  },
  "dev": {
    "scenarios": [
      {
        "id": "open-workbench",
        "title": "Open Markdown WeChat workbench",
        "steps": [
          { "openSurface": "page:/page" },
          { "openSurface": "widget:/widget" }
        ]
      },
      {
        "id": "render-markdown",
        "title": "Render Markdown without a session",
        "steps": [
          {
            "invokeTool": {
              "name": "render",
              "input": { "markdown": "# Scenario\n\nRendered by Markdown WeChat." }
            }
          },
          { "expectToolText": "Rendered Markdown WeChat HTML" }
        ]
      }
    ]
  }
}
