{
  "name": "@hana/builtin-markdown-wechat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "node --experimental-strip-types build.ts",
    "verify-package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify-package && node --check assets/app.js"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "dependencies": {
    "@hana/plugin-runtime": "0.0.0",
    "@hana/plugin-sdk": "0.0.0",
    "markdown-it": "^14.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
