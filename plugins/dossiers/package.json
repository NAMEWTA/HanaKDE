{
  "name": "@hana/builtin-dossiers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:core": "node --experimental-strip-types --test tests/foundation/*.node-test.ts tests/catalog/*.node-test.ts tests/documents/*.node-test.ts tests/index/*.node-test.ts tests/agent/*.node-test.ts tests/lifecycle/*.node-test.ts tests/exchange/*.node-test.ts tests/migration/*.node-test.ts",
    "test:ui": "vitest run --root ../.. plugins/dossiers/tests/ui/catalog/catalog-feature.test.tsx plugins/dossiers/tests/ui/operations/operations-feature.test.tsx plugins/dossiers/tests/e2e/page-host.test.tsx",
    "test": "npm run test:core && npm run test:ui",
    "build": "node --experimental-strip-types build.ts",
    "verify:package": "node --experimental-strip-types tests/package/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node --check assets/page.js && npm run verify:package",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@hana/plugin-components": "0.0.0",
    "@hana/plugin-sdk": "0.0.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "2.10.3",
    "esbuild": "^0.27.4",
    "jsdom": "^27.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
